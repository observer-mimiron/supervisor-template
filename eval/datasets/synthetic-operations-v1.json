      "risk_level": "low",
      "impact_tags": ["audience-query"],
      "business_goal": "固定快照返回正确匿名客群",
      "preconditions": {"fixture": "synthetic_audience_v1", "subject": "demo-user"},
      "request_steps": [{"action": "chat", "message": "分析沉睡客户", "conversation_id": "eval-positive-1"}],
      "expected_results": {"terminal": "completed", "event_types": ["started", "decision", "plan", "progress", "tool_call", "progress", "text", "completed"], "result": {"count": 4, "customer_ids": ["cust-001", "cust-002", "cust-006", "cust-008"], "spend_365d_total": 6200}},
      "forbidden_side_effects": {"tool_ids": ["simulated_outreach"], "max_writes": 0},
